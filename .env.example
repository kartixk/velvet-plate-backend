# =============================================================================
# Velvet Plate Backend - Environment Template (.env.example)
# Copy to .env for local development. NEVER commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.
# Placeholders only below.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Database (MongoDB Atlas) ------------------------------------------------
# Prisma needs a replica set / Atlas cluster. URL-encode special characters in the password.
DATABASE_URL=mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority

# --- Auth --------------------------------------------------------------------
# REQUIRED, min 32 chars. The server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate_a_random_secret_of_at_least_32_chars>
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12
# Optional token claims (defaults: velvet-plate-api / velvet-plate-client)
# JWT_ISSUER=velvet-plate-api
# JWT_AUDIENCE=velvet-plate-client

# --- CORS / proxy ------------------------------------------------------------
# Public URL of the frontend (e.g. https://your-frontend.vercel.app). Dev default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Optional. Trusted proxy hops, or true/false. When unset: 1 on Vercel (VERCEL=1), false elsewhere.
# TRUST_PROXY=1

# --- Logging -----------------------------------------------------------------
# error | warn | info | http | verbose | debug
LOG_LEVEL=info

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Velvet Plate <onboarding@resend.dev>

# --- Cloudinary (KYC document uploads) ---------------------------------------
# Set ENABLE_CLOUDINARY=true in production; then all three values below are required.
ENABLE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternative to the three vars above:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Optional toggles --------------------------------------------------------
# Expose Swagger UI (/api-docs) in production
# ENABLE_SWAGGER=false
# Reject non-CASH checkout even outside production
# ENFORCE_CASH_ONLY=true
# Support uplink rate limit (requests per 15 min)
# SUPPORT_RATE_LIMIT_MAX=5

# --- Demo seed (scripts/seed-demo.js only; not read by the app) --------------
DEMO_ADMIN_PASSWORD=<choose_a_demo_admin_password>
DEMO_MANAGER_PASSWORD=<choose_a_demo_manager_password>
DEMO_CUSTOMER_PASSWORD=<choose_a_demo_customer_password>
